<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_arfr_font_smoke">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page arfr-report-fonts" data-arfr-smoke="1">
                    <h2>Arabic/French Document Engine Font Smoke</h2>
                    <p lang="ar" dir="rtl">فاتورة اختبار عربية ١٢٣٤٥٦٧٨٩٠ ر.س</p>
                    <p>Facture de test francaise: aeiou c EUR 1,234.56</p>
                    <p>Mixed: شركة Test SAR 1,234.56</p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_arfr_font_smoke" model="ir.actions.report">
        <field name="name">Arabic/French Font Smoke</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">document_engine_arfr_core.report_arfr_font_smoke</field>
        <field name="report_file">document_engine_arfr_core.report_arfr_font_smoke</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
