<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="act_report_xml_view_arfr" model="ir.ui.view">
        <field name="name">ir.actions.report.form.arfr</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Arabic/French Rendering" name="arfr_rendering">
                    <group>
                        <field name="arfr_enabled"/>
                        <field name="arfr_numeral_system"/>
                        <field name="arfr_bilingual_pair"/>
                        <field name="arfr_font_family"/>
                        <field name="arfr_currency_format_policy"/>
                        <field name="arfr_layout_direction"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
