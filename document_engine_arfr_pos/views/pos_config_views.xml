<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_arfr" model="ir.ui.view">
        <field name="name">pos.config.form.arfr</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Arabic/French Receipt Rendering" name="arfr_receipt_rendering">
                    <field name="arfr_receipt_enabled"/>
                    <field name="arfr_receipt_numeral_system"/>
                    <field name="arfr_receipt_currency_policy"/>
                    <field name="arfr_receipt_layout_direction"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
