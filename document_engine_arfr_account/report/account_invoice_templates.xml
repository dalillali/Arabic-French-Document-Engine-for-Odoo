<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_invoice_arfr_bilingual_ar_fr" model="ir.actions.report">
        <field name="name">Bilingual Invoice Arabic/French</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">document_engine_arfr_account.report_invoice_arfr_bilingual</field>
        <field name="report_file">document_engine_arfr_account.report_invoice_arfr_bilingual</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="document_engine_arfr_account.paperformat_arfr_premium_document"/>
        <field name="arfr_enabled">1</field>
        <field name="arfr_bilingual_pair">ar_fr</field>
    </record>

    <record id="action_report_invoice_arfr_bilingual_ar_en" model="ir.actions.report">
        <field name="name">Bilingual Invoice Arabic/English</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">document_engine_arfr_account.report_invoice_arfr_bilingual</field>
        <field name="report_file">document_engine_arfr_account.report_invoice_arfr_bilingual</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="document_engine_arfr_account.paperformat_arfr_premium_document"/>
        <field name="arfr_enabled">1</field>
        <field name="arfr_bilingual_pair">ar_en</field>
    </record>

    <template id="report_invoice_arfr_body">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="partner" t-value="o.partner_id"/>
                <t t-set="record" t-value="o"/>
                <t t-set="currency" t-value="o.currency_id"/>
                <t t-set="secondary_lang" t-value="arfr_secondary_lang(o, partner=partner, fallback=secondary_lang_fallback)"/>
                <t t-set="title_ar" t-value="'فاتورة'"/>
                <t t-set="title_ltr" t-value="arfr_label('Invoice', secondary_lang, record=o)"/>
                <t t-set="subtitle_ar" t-value="'فاتورة عربية ولغة ثانية جاهزة للطباعة'"/>
                <t t-set="subtitle_ltr" t-value="arfr_label('Bilingual business document', secondary_lang, record=o)"/>
                <t t-set="pair_badge" t-value="arfr_label('Bilingual', secondary_lang, record=o)"/>
                <t t-set="numeral_badge" t-value="arfr_label('Smart numerals and regional currency', secondary_lang, record=o)"/>
                <t t-set="customer_ltr" t-value="arfr_label('Customer', secondary_lang, record=o)"/>
                <t t-set="date_ltr" t-value="arfr_label('Invoice Date', secondary_lang, record=o)"/>
                <t t-set="number_ltr" t-value="arfr_label('Invoice Number', secondary_lang, record=o)"/>
                <t t-set="currency_ltr" t-value="arfr_label('Currency', secondary_lang, record=o)"/>
                <t t-set="description_ltr" t-value="arfr_label('Description', secondary_lang, record=o)"/>
                <t t-set="quantity_ltr" t-value="arfr_label('Qty', secondary_lang, record=o)"/>
                <t t-set="unit_price_ltr" t-value="arfr_label('Unit Price', secondary_lang, record=o)"/>
                <t t-set="discount_ltr" t-value="arfr_label('Discount', secondary_lang, record=o)"/>
                <t t-set="subtotal_ltr" t-value="arfr_label('Subtotal', secondary_lang, record=o)"/>
                <t t-set="untaxed_ltr" t-value="arfr_label('Untaxed Amount', secondary_lang, record=o)"/>
                <t t-set="tax_ltr" t-value="arfr_label('Tax', secondary_lang, record=o)"/>
                <t t-set="total_ltr" t-value="arfr_label('Total', secondary_lang, record=o)"/>
                <t t-set="notes_ltr" t-value="arfr_label('Notes', secondary_lang, record=o)"/>
                <t t-set="signature_ltr" t-value="arfr_label('Signature', secondary_lang, record=o)"/>
                <t t-set="header_blocks" t-value="False"/>
                <t t-set="line_table_spec" t-value="False"/>
                <t t-set="totals_block" t-value="False"/>
                <t t-set="notes_block" t-value="False"/>
                <t t-set="signature_block" t-value="False"/>
                <t t-call="document_engine_arfr_core.arfr_bilingual_document">
                    <t t-call="document_engine_arfr_account.arfr_document_style"/>
                    <section class="arfr-meta-grid">
                        <div class="arfr-meta-col">
                            <t t-call="document_engine_arfr_account.arfr_bilingual_label_value">
                                <t t-set="label_ltr" t-value="customer_ltr"/>
                                <t t-set="label_ar" t-value="'العميل'"/>
                                <t t-set="value" t-value="o.partner_id.display_name"/>
                            </t>
                            <t t-call="document_engine_arfr_account.arfr_bilingual_label_value">
                                <t t-set="label_ltr" t-value="date_ltr"/>
                                <t t-set="label_ar" t-value="'التاريخ'"/>
                                <t t-set="value" t-value="arfr_format_numerals(o.invoice_date or '', None, partner=partner, record=o)"/>
                            </t>
                        </div>
                        <div class="arfr-meta-col">
                            <t t-call="document_engine_arfr_account.arfr_bilingual_label_value">
                                <t t-set="label_ltr" t-value="number_ltr"/>
                                <t t-set="label_ar" t-value="'الرقم'"/>
                                <t t-set="value" t-value="arfr_format_numerals(o.name or _('Draft'), None, partner=partner, field_key='invoice_number', record=o)"/>
                            </t>
                            <t t-call="document_engine_arfr_account.arfr_bilingual_label_value">
                                <t t-set="label_ltr" t-value="currency_ltr"/>
                                <t t-set="label_ar" t-value="'العملة'"/>
                                <t t-set="value" t-value="currency.name"/>
                            </t>
                        </div>
                    </section>

                    <table class="arfr-lines">
                        <thead>
                            <tr>
                                <th class="arfr-col-description"><span>الوصف</span><small t-out="description_ltr"/></th>
                                <th class="arfr-col-qty"><span>الكمية</span><small t-out="quantity_ltr"/></th>
                                <th class="arfr-col-money"><span>سعر الوحدة</span><small t-out="unit_price_ltr"/></th>
                                <th class="arfr-col-discount"><span>الخصم</span><small t-out="discount_ltr"/></th>
                                <th class="arfr-col-money"><span>الإجمالي</span><small t-out="subtotal_ltr"/></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr t-if="line.display_type not in ('line_section', 'line_note')">
                                    <td class="arfr-description" dir="auto"><span t-field="line.name"/></td>
                                    <td class="arfr-numeric">
                                        <t t-set="value" t-value="line.quantity"/>
                                        <t t-call="document_engine_arfr_account.arfr_formatted_quantity"/>
                                    </td>
                                    <td class="arfr-numeric">
                                        <t t-set="value" t-value="line.price_unit"/>
                                        <t t-call="document_engine_arfr_account.arfr_formatted_amount"/>
                                    </td>
                                    <td class="arfr-numeric">
                                        <span class="arfr-number" t-out="arfr_format_numerals(line.discount, None, partner=partner, record=o)"/>%
                                    </td>
                                    <td class="arfr-numeric">
                                        <t t-set="value" t-value="line.price_subtotal"/>
                                        <t t-call="document_engine_arfr_account.arfr_formatted_amount"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <t t-call="document_engine_arfr_account.arfr_bilingual_totals"/>

                    <t t-set="note_value" t-value="o.narration"/>
                    <t t-call="document_engine_arfr_account.arfr_notes_block"/>

                    <t t-call="document_engine_arfr_account.arfr_bilingual_signature"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_invoice_arfr_bilingual">
        <t t-set="secondary_lang_fallback" t-value="None"/>
        <t t-call="document_engine_arfr_account.report_invoice_arfr_body"/>
    </template>

    <template id="report_invoice_document_arfr_direction" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class" add="arfr-table arfr-direction-aware" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="class" add="arfr-total-block arfr-direction-aware" separator=" "/>
        </xpath>
        <xpath expr="//div[@name='comment']" position="attributes">
            <attribute name="class" add="arfr-notes-block arfr-direction-aware" separator=" "/>
        </xpath>
    </template>
</odoo>
